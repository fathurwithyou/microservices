# Service ports
BMKG_PORT=8081
PVMBG_PORT=8082
AGGREGATOR_GRPC_PORT=9090
AGGREGATOR_HTTP_PORT=8090
AUTH_GRPC_PORT=9091
CLIENT_API_PORT=8080
BMKG_HOST_PORT=8081
PVMBG_HOST_PORT=8082
AGGREGATOR_HTTP_HOST_PORT=8090
AGGREGATOR_GRPC_HOST_PORT=9090
AUTH_GRPC_HOST_PORT=9091
CLIENT_API_HOST_PORT=8080
DEMO_API_PORT=8086
DEMO_API_HOST_PORT=8086
DEMO_CONSOLE_HOST_PORT=3000
BMKG_URL=http://bmkg:8081
PVMBG_URL=http://pvmbg:8082
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
AGGREGATOR_GRPC_ADDR=aggregator:9090
AUTH_GRPC_ADDR=auth:9091

# Independent trust domains (replace every value locally)
BMKG_API_KEY=replace-with-bmkg-key
PVMBG_TOKEN=replace-with-pvmbg-token
PVMBG_ADMIN_KEY=replace-with-pvmbg-admin-key
INTERNAL_SERVICE_TOKEN=replace-with-internal-service-token

# Downstream client credentials
MEDIA_CLIENT_SECRET=replace-with-media-secret
FIELD_TEAM_CLIENT_SECRET=replace-with-field-team-secret
BNPB_OPS_CLIENT_SECRET=replace-with-bnpb-ops-secret

# Runtime configuration
SEED_COUNT=20
POLL_INTERVAL=3s
OUTBOX_POLL_INTERVAL=500ms
NEW_EVENT_INTERVAL=10s
NEW_REPORT_INTERVAL=10s
BMKG_DELAY=100ms
PVMBG_MIN_DELAY=500ms
PVMBG_MAX_DELAY=3s
ACCESS_TOKEN_TTL=60s
MAX_INFLIGHT_REQUESTS=64
REQUEST_TIMEOUT=5s

# Persistence and messaging
STORE_DRIVER=postgres
AGGREGATOR_DATABASE_URL=postgres://aggregator:replace-with-aggregator-db-password@postgres:5432/aggregator_db?sslmode=disable
AUTH_DATABASE_URL=postgres://auth:replace-with-auth-db-password@postgres:5432/auth_db?sslmode=disable
AUTH_DATABASE_WAIT=60s
RABBITMQ_URL=amqp://replace-with-rabbitmq-user:replace-with-rabbitmq-password@rabbitmq:5672/
POSTGRES_ADMIN_PASSWORD=replace-with-postgres-admin-password
AGGREGATOR_DB_PASSWORD=replace-with-aggregator-db-password
AUTH_DB_PASSWORD=replace-with-auth-db-password
RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
