# Service ports
BMKG_PORT=8081
PVMBG_PORT=8082
AGGREGATOR_GRPC_PORT=9090
AGGREGATOR_HTTP_PORT=8090
AUTH_GRPC_PORT=9091
CLIENT_API_PORT=8080
BMKG_HOST_PORT=8081
PVMBG_HOST_PORT=8082
AGGREGATOR_HTTP_HOST_PORT=8090
AGGREGATOR_GRPC_HOST_PORT=9090
AUTH_GRPC_HOST_PORT=9091
CLIENT_API_HOST_PORT=8080
DEMO_API_PORT=8086
DEMO_API_HOST_PORT=8086
DEMO_CONSOLE_HOST_PORT=3000
BMKG_URL=http://bmkg:8081
PVMBG_URL=http://pvmbg:8082
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
AGGREGATOR_GRPC_ADDR=aggregator:9090
AUTH_GRPC_ADDR=auth:9091

# Independent trust domains (replace every value locally)
BMKG_API_KEY=replace-with-bmkg-key
PVMBG_TOKEN=replace-with-pvmbg-token
PVMBG_ADMIN_KEY=replace-with-pvmbg-admin-key

# M2 Feed Satelit (asisten). Simpan token asli di .env atau Kubernetes Secret.
FEED_URL=https://satellite.naufarrel.dev
FEED_TOKEN=replace-with-satellite-feed-token
# Admin token of the in-cluster Feed Satelit stand-in (services/satellite-feed),
# used only by the P4 rehearsal: scripts/m2-demo.sh p4-sim.
FEED_MOCK_ADMIN_TOKEN=replace-with-random-admin-token
SENSOR_URL=
SENSOR_TOKEN=replace-with-coastal-sensor-token
PANTAI_PROFILE=practice
# Store DSNs are not configured here. Each store owner has its own database
# and SQL user, fixed in docker-compose.yml (and in the Kubernetes manifests,
# with per-user client certificates), so an old root@defaultdb value cannot
# bypass ownership. For `go run` outside Compose, export them yourself:
#   SATELLITE_DATABASE_URL=postgresql://satellite@127.0.0.1:26257/satellite_db?sslmode=disable
#   COASTAL_DATABASE_URL=postgresql://coastal@127.0.0.1:26257/coastal_db?sslmode=disable
INTERNAL_SERVICE_TOKEN=replace-with-internal-service-token
AUDIT_TOKEN=replace-with-audit-token
# BNPB Internal Ops credential for POST /internal/ops/replay and
# GET /internal/ops/failures (raw failed payloads). Must differ from
# AUDIT_TOKEN; Ops endpoints are disabled (503) while this is empty.
OPS_TOKEN=replace-with-ops-token

# Downstream client credentials
MEDIA_CLIENT_SECRET=replace-with-media-secret
FIELD_TEAM_CLIENT_SECRET=replace-with-field-team-secret
BNPB_OPS_CLIENT_SECRET=replace-with-bnpb-ops-secret

# Runtime configuration
SEED_COUNT=20
POLL_INTERVAL=3s
OUTBOX_POLL_INTERVAL=500ms
LEADER_TTL=15s
LEADER_RENEW=5s
# Automatic retry of transient ingest failures (status=retrying).
FAILURE_RETRY_INTERVAL=30s
FAILURE_RETRY_MAX_ATTEMPTS=5
# coastal-ingestor active/standby lease; short so a critical reading still
# reaches Tim Lapangan within 5 s after a failover.
COASTAL_LEADER_TTL=6s
COASTAL_LEADER_RENEW=2s
NEW_EVENT_INTERVAL=10s
NEW_REPORT_INTERVAL=10s
BMKG_DELAY=100ms
PVMBG_MIN_DELAY=500ms
PVMBG_MAX_DELAY=3s
ACCESS_TOKEN_TTL=60s
MAX_INFLIGHT_REQUESTS=64
REQUEST_TIMEOUT=5s

# Persistence and messaging
STORE_DRIVER=cockroach
# Used only by `go run` and scripts outside Compose; Compose fixes the
# aggregator DSN itself.
AGGREGATOR_DATABASE_URL=postgresql://aggregator@127.0.0.1:26257/aggregator_db?sslmode=disable
# Kubernetes: the aggregator DSN (user aggregator, aggregator_db, client cert
# from Secret cockroach-client-aggregator) is set in workloads.yaml.
AUTH_DATABASE_URL=postgres://auth:replace-with-auth-db-password@postgres:5432/auth_db?sslmode=disable
AUTH_DATABASE_WAIT=60s
RABBITMQ_URL=amqp://replace-with-rabbitmq-user:replace-with-rabbitmq-password@rabbitmq:5672/
POSTGRES_ADMIN_PASSWORD=replace-with-postgres-admin-password
AUTH_DB_PASSWORD=replace-with-auth-db-password
RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
